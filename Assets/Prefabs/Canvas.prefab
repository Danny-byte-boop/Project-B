  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a22dc3528a939b34ba178b5f123bb326, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textComponent: {fileID: 85260549969576472}
  lines:
  - Once upon a time,
  - in a green pasture far far away.
  - In the land of Woozie, there lived a man named Dirk.
  - He was no ordinary man as he once thought.
  - He discovered that he could jump higher than other men his age, and he loves
    to dance
  - Dirk could now use spacebar to double jump, and he was overjoyed.
  - He discovered a new superpower.
  - He also could use A & D to move left and right.
  - Is there nothing Dirk can't do?
  textSpeed: 0.12
